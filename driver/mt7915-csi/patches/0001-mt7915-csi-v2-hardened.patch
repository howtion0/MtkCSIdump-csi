+static int csi_group_idx(u8 mode, u8 ch_bw, u8 data_bw, u8 pri_ch_idx)
+{
+	u8 group;
+
+	if (mode > 2 || ch_bw > CSI_BW80 || data_bw > ch_bw)
+		return -EINVAL;
+
+	if (ch_bw < 2 || data_bw < 1)
+		group = ch_bw * ch_bw + pri_ch_idx;
+	else
+		group = ch_bw * ch_bw + (data_bw + 1) * 2 + pri_ch_idx;
+
+	if (group >= 11)
+		return -EINVAL;
+
+	return mode * 11 + group;
+}
+
+static int mt7915_csi_parse_mac(struct nlattr *attr, u8 *mac_addr)
+{
+	bool seen[ETH_ALEN] = {};
+	struct nlattr *cur;
+	int count = 0, rem;
+
+	nla_for_each_nested(cur, attr, rem) {
+		u16 idx = nla_type(cur);
+
+		if (idx >= ETH_ALEN || seen[idx] || nla_len(cur) != sizeof(u8))
+			return -EINVAL;
+
+		mac_addr[idx] = nla_get_u8(cur);
+		seen[idx] = true;
+		count++;
+	}
+
+	if (rem || count != ETH_ALEN || !is_valid_ether_addr(mac_addr))
+		return -EINVAL;
+
+	return 0;
+}
