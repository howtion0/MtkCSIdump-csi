+
+static int
+mt7915_mcu_parse_csi(const u8 *buf, size_t len, struct csi_data **result,
+		     u8 *band_hint)
+{
+	struct csi_data *csi;
+	const u8 *data_i = NULL, *data_q = NULL;
+	u32 data_i_len = 0, data_q_len = 0;
+	u32 required, seen = 0;
+	u16 available_count, expected_count;
+	bool has_segment;
+	int i, ret = -EINVAL;
+
+	csi = kzalloc(sizeof(*csi), GFP_KERNEL);
+	if (!csi)
+		return -ENOMEM;
+	*band_hint = U8_MAX;
+
+	while (len) {
+		const struct csi_tlv *tlv;
+		const u8 *payload;
+		u32 tag, tlv_len, value;
+
+		if (len < sizeof(*tlv))
+			goto out;
+
+		tlv = (const struct csi_tlv *)buf;
+		tag = get_unaligned_le32(buf);
+		tlv_len = get_unaligned_le32(buf + sizeof(tlv->tag));
+		if (tlv_len > len - sizeof(*tlv))
+			goto out;
+
+		payload = tlv->data;
+		if (tag <= CSI_TLV_MAX_TAG && seen & BIT(tag))
+			goto out;
+
+		switch (tag) {
+		case CSI_EVENT_CSI_I_DATA:
+		case CSI_EVENT_CSI_Q_DATA:
+			if (!tlv_len || tlv_len > CSI_MAX_COUNT * sizeof(s16) ||
+			    tlv_len % sizeof(s16))
+				goto out;
+			if (tag == CSI_EVENT_CSI_I_DATA) {
+				data_i = payload;
+				data_i_len = tlv_len;
+			} else {
+				data_q = payload;
+				data_q_len = tlv_len;
+			}
+			break;
+		case CSI_EVENT_TA:
+			if (tlv_len < ETH_ALEN || tlv_len > 8)
+				goto out;
+			ether_addr_copy(csi->ta, payload);
+			break;
+		case CSI_EVENT_RSVD13:
+		case CSI_EVENT_RSVD14:
+		case CSI_EVENT_RSVD15:
+		case CSI_EVENT_RSVD16:
+			break;
+		case CSI_EVENT_FW_VER:
+		case CSI_EVENT_CBW:
+		case CSI_EVENT_RSSI:
+		case CSI_EVENT_SNR:
+		case CSI_EVENT_BAND:
+		case CSI_EVENT_CSI_NUM:
+		case CSI_EVENT_DBW:
+		case CSI_EVENT_CH_IDX:
+		case CSI_EVENT_EXTRA_INFO:
+		case CSI_EVENT_RX_MODE:
+		case CSI_EVENT_CHAIN_INFO:
+		case CSI_EVENT_TX_RX_IDX:
+		case CSI_EVENT_TS:
+		case CSI_EVENT_PKT_SN:
+		case CSI_EVENT_BW_SEG:
+		case CSI_EVENT_REMAIN_LAST:
+		case CSI_EVENT_TR_STREAM:
+			if (tlv_len != sizeof(__le32))
+				goto out;
+
+			value = get_unaligned_le32(payload);
+			switch (tag) {
+			case CSI_EVENT_FW_VER:
+				csi->fw_ver = value;
+				break;
+			case CSI_EVENT_CBW:
+				if (value > CSI_BW80)
+					goto out;
+				csi->ch_bw = value;
+				break;
+			case CSI_EVENT_RSSI:
+				csi->rssi = value;
+				break;
+			case CSI_EVENT_SNR:
+				csi->snr = value;
+				break;
+			case CSI_EVENT_BAND:
+				if (value > 1)
+					goto out;
+				csi->band = value;
+				*band_hint = value;
+				break;
+			case CSI_EVENT_CSI_NUM:
+				if (!value || value > CSI_MAX_COUNT)
+					goto out;
+				csi->data_num = value;
+				break;
+			case CSI_EVENT_DBW:
+				if (value > CSI_BW80)
+					goto out;
+				csi->data_bw = value;
+				break;
+			case CSI_EVENT_CH_IDX:
+				if (value > U8_MAX)
+					goto out;
+				csi->pri_ch_idx = value;
+				break;
+			case CSI_EVENT_EXTRA_INFO:
+				csi->info = value;
+				break;
+			case CSI_EVENT_RX_MODE:
+				csi->rx_mode = u32_get_bits(value, GENMASK(15, 0));
+				break;
+			case CSI_EVENT_CHAIN_INFO:
+				csi->chain_info = value;
+				break;
+			case CSI_EVENT_TX_RX_IDX:
+				csi->tx_idx = u32_get_bits(value, GENMASK(31, 16));
+				csi->rx_idx = u32_get_bits(value, GENMASK(15, 0));
+				break;
+			case CSI_EVENT_TS:
+				csi->ts = value;
+				break;
+			case CSI_EVENT_PKT_SN:
+				if (value > U16_MAX)
+					goto out;
+				csi->pkt_sn = value;
+				csi->metadata_valid |= MT7915_CSI_VALID_PKT_SN;
+				break;
+			case CSI_EVENT_BW_SEG:
+				csi->segment_num = value;
+				csi->metadata_valid |= MT7915_CSI_VALID_SEGMENT;
+				break;
+			case CSI_EVENT_REMAIN_LAST:
+				if (value > 1)
+					goto out;
+				csi->remain_last = value;
+				csi->metadata_valid |= MT7915_CSI_VALID_REMAIN_LAST;
+				break;
+			case CSI_EVENT_TR_STREAM:
+				if (value > U8_MAX)
+					goto out;
+				csi->tr_stream = value;
+				csi->metadata_valid |= MT7915_CSI_VALID_TR_STREAM;
+				break;
+			default:
+				break;
+			}
+			break;
+		default:
+			/* Future firmware may append tags.  Safely skip them. */
+			break;
+		}
+
+		if (tag <= CSI_TLV_MAX_TAG)
+			seen |= BIT(tag);
+		buf += sizeof(*tlv) + tlv_len;
+		len -= sizeof(*tlv) + tlv_len;
+	}
+
+	required = BIT(CSI_EVENT_CBW) | BIT(CSI_EVENT_BAND) |
+		   BIT(CSI_EVENT_CSI_NUM) | BIT(CSI_EVENT_CSI_I_DATA) |
+		   BIT(CSI_EVENT_CSI_Q_DATA) | BIT(CSI_EVENT_DBW) |
+		   BIT(CSI_EVENT_TA) | BIT(CSI_EVENT_CHAIN_INFO) |
+		   BIT(CSI_EVENT_TX_RX_IDX) | BIT(CSI_EVENT_TS);
+	if ((seen & required) != required ||
+	    data_i_len != data_q_len ||
+	    csi->data_bw > csi->ch_bw)
+		goto out;
+	has_segment = csi->metadata_valid & MT7915_CSI_VALID_SEGMENT;
+	if (has_segment !=
+	    !!(csi->metadata_valid & MT7915_CSI_VALID_REMAIN_LAST))
+		goto out;
+	available_count = data_i_len / sizeof(s16);
+
+	switch (csi->ch_bw) {
+	case CSI_BW20:
+		expected_count = CSI_BW20_DATA_COUNT;
+		break;
+	case CSI_BW40:
+		expected_count = CSI_BW40_DATA_COUNT;
+		break;
+	case CSI_BW80:
+		expected_count = CSI_BW80_DATA_COUNT;
+		break;
+	default:
+		goto out;
+	}
+
+	/*
+	 * MT7981 firmware exists in two wire variants: one trims vector TLVs
+	 * to the active channel width, while another pads every vector to 256
+	 * samples.  Accept both, but never export padding as real subcarriers.
+	 */
+	if (csi->ch_bw == CSI_BW80 && has_segment) {
+		if (csi->data_num > available_count)
+			goto out;
+	} else {
+		if (available_count < expected_count ||
+		    (csi->data_num != expected_count &&
+		     csi->data_num != available_count))
+			goto out;
+		csi->data_num = expected_count;
+	}
+
+	for (i = 0; i < csi->data_num; i++) {
+		csi->data_i[i] = get_unaligned_le16(data_i + i * sizeof(s16));
+		csi->data_q[i] = get_unaligned_le16(data_q + i * sizeof(s16));
+	}
+
+	*result = csi;
+	return 0;
+
+out:
+	kfree(csi);
+	return ret;
+}
+
+static struct mt7915_phy *
+mt7915_csi_get_phy(struct mt7915_dev *dev, u8 band)
+{
+	struct mt7915_phy *phy = &dev->phy;
+	struct mt7915_phy *ext_phy;
+
+	if (phy->mt76->band_idx == band)
+		return phy;
+
+	ext_phy = mt7915_ext_phy(dev);
+	if (ext_phy && ext_phy->mt76->band_idx == band)
+		return ext_phy;
+
+	return NULL;
+}
+
+static bool mt7915_csi_interval_elapsed(u32 now, u32 last, u32 interval)
+{
+	return !interval || (u32)(now - last) >= interval;
+}
+
+enum mt7915_csi_segment_result {
+	MT7915_CSI_SEGMENT_ERROR = -1,
+	MT7915_CSI_SEGMENT_STORED,
+	MT7915_CSI_SEGMENT_READY,
+};
+
+static void mt7915_csi_segment_reset(struct mt7915_phy *phy)
+{
+	kfree(phy->csi.segment);
+	phy->csi.segment = NULL;
+}
+
+static void mt7915_csi_mark_malformed(struct mt7915_phy *phy)
+{
+	spin_lock_bh(&phy->csi.csi_lock);
+	mt7915_csi_segment_reset(phy);
+	phy->csi.malformed++;
+	spin_unlock_bh(&phy->csi.csi_lock);
+}
+
+static bool
+mt7915_csi_segment_matches(const struct csi_data *first,
+			   const struct csi_data *next)
+{
+	u8 pkt_mask = MT7915_CSI_VALID_PKT_SN;
+	u8 stream_mask = MT7915_CSI_VALID_TR_STREAM;
+
+	if ((first->metadata_valid & pkt_mask) != pkt_mask ||
+	    (next->metadata_valid & pkt_mask) != pkt_mask ||
+	    first->pkt_sn != next->pkt_sn ||
+	    first->chain_info != next->chain_info ||
+	    !ether_addr_equal(first->ta, next->ta) ||
+	    first->band != next->band || first->tx_idx != next->tx_idx ||
+	    first->rx_idx != next->rx_idx || first->ch_bw != next->ch_bw ||
+	    first->data_bw != next->data_bw ||
+	    first->pri_ch_idx != next->pri_ch_idx ||
+	    first->rx_mode != next->rx_mode ||
+	    first->segment_num == U32_MAX ||
+	    next->segment_num != first->segment_num + 1)
+		return false;
+
+	if ((first->metadata_valid & stream_mask) !=
+	    (next->metadata_valid & stream_mask))
+		return false;
+
+	return !(first->metadata_valid & stream_mask) ||
+	       first->tr_stream == next->tr_stream;
+}
+
+/* Caller holds csi_lock.  This function consumes @part on every path. */
+static int
+mt7915_csi_reassemble(struct mt7915_phy *phy, struct csi_data *part,
+		      struct csi_data **ready)
+{
+	struct csi_data *first = phy->csi.segment;
+	bool has_segment, has_remain;
+	u16 offset;
+
+	*ready = NULL;
+	has_segment = part->metadata_valid & MT7915_CSI_VALID_SEGMENT;
+	has_remain = part->metadata_valid & MT7915_CSI_VALID_REMAIN_LAST;
+
+	if (first && (part->ch_bw != CSI_BW80 || !has_segment ||
+		      part->segment_num == 0)) {
+		mt7915_csi_segment_reset(phy);
+		phy->csi.malformed++;
+		first = NULL;
+	}
+
+	if (part->ch_bw != CSI_BW80) {
+		if ((has_segment && part->segment_num) ||
+		    (has_remain && part->remain_last))
+			goto malformed;
+
+		*ready = part;
+		return MT7915_CSI_SEGMENT_READY;
+	}
+
+	if (!has_segment) {
+		if (part->data_num != CSI_BW80_DATA_COUNT)
+			goto malformed;
+
+		*ready = part;
+		return MT7915_CSI_SEGMENT_READY;
+	}
+
+	if (part->segment_num == 0) {
+		if (!part->remain_last) {
+			if (part->data_num != CSI_BW80_DATA_COUNT)
+				goto malformed;
+
+			*ready = part;
+			return MT7915_CSI_SEGMENT_READY;
+		}
+
+		if (!(part->metadata_valid & MT7915_CSI_VALID_PKT_SN) ||
+		    part->data_num >= CSI_BW80_DATA_COUNT)
+			goto malformed;
+
+		phy->csi.segment = part;
+		return MT7915_CSI_SEGMENT_STORED;
+	}
+
+	if (!first || !mt7915_csi_segment_matches(first, part) ||
+	    part->data_num > CSI_BW80_DATA_COUNT - first->data_num)
+		goto malformed_sequence;
+
+	offset = first->data_num;
+	memcpy(&first->data_i[offset], part->data_i,
+	       part->data_num * sizeof(first->data_i[0]));
+	memcpy(&first->data_q[offset], part->data_q,
+	       part->data_num * sizeof(first->data_q[0]));
+	first->data_num += part->data_num;
+	first->segment_num = part->segment_num;
+	first->remain_last = part->remain_last;
+	first->metadata_valid |= part->metadata_valid;
+	kfree(part);
+
+	if (first->remain_last) {
+		if (first->data_num >= CSI_BW80_DATA_COUNT)
+			goto malformed_buffer;
+
+		return MT7915_CSI_SEGMENT_STORED;
+	}
+
+	if (first->data_num != CSI_BW80_DATA_COUNT)
+		goto malformed_buffer;
+
+	phy->csi.segment = NULL;
+	*ready = first;
+	return MT7915_CSI_SEGMENT_READY;
+
+malformed_sequence:
+	mt7915_csi_segment_reset(phy);
+	kfree(part);
+	phy->csi.malformed++;
+	return MT7915_CSI_SEGMENT_ERROR;
+
+malformed_buffer:
+	mt7915_csi_segment_reset(phy);
+	phy->csi.malformed++;
+	return MT7915_CSI_SEGMENT_ERROR;
+
+malformed:
+	kfree(part);
+	phy->csi.malformed++;
+	return MT7915_CSI_SEGMENT_ERROR;
+}
+
+static int
+mt7915_mcu_report_csi(struct mt7915_dev *dev, struct sk_buff *skb)
+{
+	struct mt7915_phy *phy;
+	struct csi_data *csi, *ready, *old = NULL;
+	u8 band_hint;
+	int ret;
+
+	if (skb->len < sizeof(struct mt76_connac2_mcu_rxd))
+		return -EINVAL;
+
+	skb_pull(skb, sizeof(struct mt76_connac2_mcu_rxd));
+	ret = mt7915_mcu_parse_csi(skb->data, skb->len, &csi, &band_hint);
+	if (ret) {
+		if (ret != -ENOMEM) {
+			phy = band_hint <= 1 ?
+				mt7915_csi_get_phy(dev, band_hint) : NULL;
+			if (phy) {
+				mt7915_csi_mark_malformed(phy);
+			} else {
+				struct mt7915_phy *ext_phy = mt7915_ext_phy(dev);
+
+				mt7915_csi_mark_malformed(&dev->phy);
+				if (ext_phy)
+					mt7915_csi_mark_malformed(ext_phy);
+			}
+		}
+		return ret;
+	}
+
+	phy = mt7915_csi_get_phy(dev, csi->band);
+	if (!phy) {
+		kfree(csi);
+		return -EINVAL;
+	}
+
+	INIT_LIST_HEAD(&csi->node);
+	spin_lock_bh(&phy->csi.csi_lock);
+
+	if (!phy->csi.enable) {
+		spin_unlock_bh(&phy->csi.csi_lock);
+		kfree(csi);
+		return 0;
+	}
+
+	ret = mt7915_csi_reassemble(phy, csi, &ready);
+	if (ret != MT7915_CSI_SEGMENT_READY) {
+		spin_unlock_bh(&phy->csi.csi_lock);
+		return ret == MT7915_CSI_SEGMENT_ERROR ? -EINVAL : 0;
+	}
+	csi = ready;
+
+	if (phy->csi.last_record_valid &&
+	    !mt7915_csi_interval_elapsed(csi->ts, phy->csi.last_record,
+					   phy->csi.interval)) {
+		spin_unlock_bh(&phy->csi.csi_lock);
+		kfree(csi);
+		return 0;
+	}
+
+	if (phy->csi.count >= CSI_MAX_BUF_NUM) {
+		old = list_first_entry(&phy->csi.csi_list,
+				       struct csi_data, node);
+		list_del(&old->node);
+		phy->csi.count--;
+		phy->csi.dropped++;
+	}
+
+	list_add_tail(&csi->node, &phy->csi.csi_list);
+	phy->csi.count++;
+
+	if (csi->chain_info & BIT(15)) {
+		phy->csi.last_record = csi->ts;
+		phy->csi.last_record_valid = true;
+	}
+	spin_unlock_bh(&phy->csi.csi_lock);
+	kfree(old);
+
+	return 0;
+}
+#endif
