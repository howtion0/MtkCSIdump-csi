+static int mt7915_vendor_csi_ctrl(struct wiphy *wiphy,
+				  struct wireless_dev *wdev,
+				  const void *data,
+				  int data_len)
+{
+	struct ieee80211_hw *hw = wiphy_to_ieee80211_hw(wiphy);
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+	struct nlattr *tb[NUM_MTK_VENDOR_ATTRS_CSI_CTRL] = {};
+	struct csi_data *segment = NULL;
+	LIST_HEAD(free_list);
+	int err;
+
+	err = nla_parse(tb, MTK_VENDOR_ATTR_CSI_CTRL_MAX, data, data_len,
+			csi_ctrl_policy, NULL);
+	if (err)
+		return err;
+
+	if (tb[MTK_VENDOR_ATTR_CSI_CTRL_CFG]) {
+		bool seen_mode = false, seen_type = false;
+		bool seen_v1 = false, seen_v2 = false;
+		u8 mode = 0, type = 0, v1 = 0;
+		u8 mac_addr[ETH_ALEN] = {};
+		struct nlattr *cur;
+		u32 v2 = 0;
+		int rem;
+
+		nla_for_each_nested(cur, tb[MTK_VENDOR_ATTR_CSI_CTRL_CFG], rem) {
+			switch (nla_type(cur)) {
+			case MTK_VENDOR_ATTR_CSI_CTRL_CFG_MODE:
+				if (seen_mode || nla_len(cur) != sizeof(u8))
+					return -EINVAL;
+				mode = nla_get_u8(cur);
+				seen_mode = true;
+				break;
+			case MTK_VENDOR_ATTR_CSI_CTRL_CFG_TYPE:
+				if (seen_type || nla_len(cur) != sizeof(u8))
+					return -EINVAL;
+				type = nla_get_u8(cur);
+				seen_type = true;
+				break;
+			case MTK_VENDOR_ATTR_CSI_CTRL_CFG_VAL1:
+				if (seen_v1 || nla_len(cur) != sizeof(u8))
+					return -EINVAL;
+				v1 = nla_get_u8(cur);
+				seen_v1 = true;
+				break;
+			case MTK_VENDOR_ATTR_CSI_CTRL_CFG_VAL2:
+				if (seen_v2)
+					return -EINVAL;
+				if (nla_len(cur) == sizeof(u8))
+					v2 = nla_get_u8(cur);
+				else if (nla_len(cur) == sizeof(u32))
+					v2 = nla_get_u32(cur);
+				else
+					return -EINVAL;
+				seen_v2 = true;
+				break;
+			default:
+				return -EINVAL;
+			}
+		}
+
+		if (rem || !seen_mode || mode > 2)
+			return -EINVAL;
+
+		if (tb[MTK_VENDOR_ATTR_CSI_CTRL_MAC_ADDR]) {
+			struct nlattr *mac;
+
+			mac = tb[MTK_VENDOR_ATTR_CSI_CTRL_MAC_ADDR];
+			err = mt7915_csi_parse_mac(mac, mac_addr);
+			if (err)
+				return err;
+		}
+
+		err = mt7915_mcu_set_csi(phy, mode, type, v1, v2, mac_addr);
+		if (err)
+			return err;
+
+		spin_lock_bh(&phy->csi.csi_lock);
+		phy->csi.enable = !!mode;
+		segment = phy->csi.segment;
+		phy->csi.segment = NULL;
+
+		if (mode == 2 && type == 5) {
+			phy->csi.mask = v1 >= 1;
+			phy->csi.reorder = v1 == 2;
+		}
+
+		if (mode == 0 || mode == 2) {
+			list_splice_init(&phy->csi.csi_list, &free_list);
+			phy->csi.count = 0;
+		}
+
+		if (mode == 0 || mode == 1) {
+			phy->csi.last_record = 0;
+			phy->csi.last_record_valid = false;
+		}
+		spin_unlock_bh(&phy->csi.csi_lock);
+
+		kfree(segment);
+		mt7915_csi_free_list(&free_list);
+	}
+
+	if (tb[MTK_VENDOR_ATTR_CSI_CTRL_INTERVAL]) {
+		spin_lock_bh(&phy->csi.csi_lock);
+		phy->csi.interval =
+			nla_get_u32(tb[MTK_VENDOR_ATTR_CSI_CTRL_INTERVAL]);
+		phy->csi.last_record_valid = false;
+		spin_unlock_bh(&phy->csi.csi_lock);
+	}
+
+	return 0;
+}
+
+static void
+mt7915_vendor_csi_tone_mask(struct csi_data *csi, bool mask, bool reorder)
+{
+	const struct csi_mask *cmask;
+	u8 mode, pri_ch_idx = csi->pri_ch_idx;
+	int group, i;
+
+	if (!mask || csi->rx_mode == MT_PHY_TYPE_CCK)
+		return;
+
+	switch (csi->rx_mode) {
+	case MT_PHY_TYPE_OFDM:
+		mode = 0;
+		break;
+	case MT_PHY_TYPE_HT:
+	case MT_PHY_TYPE_VHT:
+		mode = 1;
+		break;
+	case MT_PHY_TYPE_HE_SU:
+		mode = 2;
+		break;
+	default:
+		return;
+	}
+
+	if (csi->data_bw == CSI_BW40)
+		pri_ch_idx /= 2;
+
+	group = csi_group_idx(mode, csi->ch_bw, csi->data_bw, pri_ch_idx);
+	if (group < 0 || group >= (int)ARRAY_SIZE(csi_mask_groups))
+		return;
+
+	cmask = &csi_mask_groups[group];
+	for (i = 0; i < ARRAY_SIZE(cmask->null); i++) {
+		const struct csi_null_tone *ntone = &cmask->null[i];
+		u16 start = ntone->start;
+		u16 end = ntone->end;
+		int j;
+
+		if (!start && !end && i > 0)
+			break;
+		if (!end)
+			end = start;
+		if (start >= csi->data_num)
+			continue;
+		end = min_t(u16, end, csi->data_num - 1);
+
+		for (j = start; j <= end; j++) {
+			csi->data_i[j] = 0;
+			csi->data_q[j] = 0;
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(cmask->pilot); i++) {
+		u16 pilot = cmask->pilot[i];
+
+		if (!pilot)
+			break;
+		if (pilot >= csi->data_num)
+			continue;
+
+		csi->data_i[pilot] = 0;
+		csi->data_q[pilot] = 0;
+	}
+
+	if (!reorder)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(cmask->ro); i++) {
+		const struct csi_reorder *ro = &cmask->ro[i];
+		u16 count, dest = ro->dest;
+		u16 start = ro->start;
+		u16 end = ro->end;
+
+		if (!dest && !start && !end)
+			break;
+		if (dest == start)
+			continue;
+		if (dest >= csi->data_num || start >= csi->data_num)
+			continue;
+
+		if (!end) {
+			csi->data_i[dest] = csi->data_i[start];
+			csi->data_q[dest] = csi->data_q[start];
+			continue;
+		}
+
+		if (end < start || end >= csi->data_num)
+			continue;
+		count = end - start + 1;
+		if (dest + count > csi->data_num)
+			continue;
+
+		memmove(&csi->data_i[dest], &csi->data_i[start],
+			count * sizeof(csi->data_i[0]));
+		memmove(&csi->data_q[dest], &csi->data_q[start],
+			count * sizeof(csi->data_q[0]));
+	}
+}
+
+static int
+mt7915_csi_put_mac(struct sk_buff *skb, const u8 *mac)
+{
+	struct nlattr *nest;
+	int i;
+
+	nest = nla_nest_start(skb, MTK_VENDOR_ATTR_CSI_DATA_TA);
+	if (!nest)
+		return -EMSGSIZE;
+
+	for (i = 0; i < ETH_ALEN; i++) {
+		if (nla_put_u8(skb, i, mac[i])) {
+			nla_nest_cancel(skb, nest);
+			return -EMSGSIZE;
+		}
+	}
+
+	nla_nest_end(skb, nest);
+	return 0;
+}
+
+static int
+mt7915_csi_put_vector(struct sk_buff *skb, int attr, const s16 *values,
+		      u16 count)
+{
+	struct nlattr *nest;
+	int i;
+
+	nest = nla_nest_start(skb, attr);
+	if (!nest)
+		return -EMSGSIZE;
+
+	for (i = 0; i < count; i++) {
+		if (nla_put_u16(skb, i, values[i])) {
+			nla_nest_cancel(skb, nest);
+			return -EMSGSIZE;
+		}
+	}
+
+	nla_nest_end(skb, nest);
+	return 0;
+}
+
+static int
+mt7915_csi_put_record(struct sk_buff *skb, const struct csi_data *csi)
+{
+	struct nlattr *record;
+
+	record = nla_nest_start(skb, MTK_VENDOR_ATTR_CSI_CTRL_DATA);
+	if (!record)
+		return -EMSGSIZE;
+
+	if (nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_VER, 2) ||
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_RSSI, csi->rssi) ||
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_SNR, csi->snr) ||
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_BW, csi->data_bw) ||
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_CH_IDX,
+		       csi->pri_ch_idx) ||
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_MODE, csi->rx_mode) ||
+	    nla_put_u16(skb, MTK_VENDOR_ATTR_CSI_DATA_TX_ANT, csi->tx_idx) ||
+	    nla_put_u16(skb, MTK_VENDOR_ATTR_CSI_DATA_RX_ANT, csi->rx_idx) ||
+	    nla_put_u32(skb, MTK_VENDOR_ATTR_CSI_DATA_INFO, csi->info) ||
+	    nla_put_u32(skb, MTK_VENDOR_ATTR_CSI_DATA_H_IDX,
+			csi->chain_info) ||
+	    nla_put_u32(skb, MTK_VENDOR_ATTR_CSI_DATA_TS, csi->ts) ||
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_CH_BW, csi->ch_bw) ||
+	    nla_put_u32(skb, MTK_VENDOR_ATTR_CSI_DATA_NUM, csi->data_num) ||
+	    nla_put_u32(skb, MTK_VENDOR_ATTR_CSI_DATA_CHAIN_INFO,
+			csi->chain_info) ||
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_BAND, csi->band))
+		goto nla_put_failure;
+
+	if ((csi->metadata_valid & MT7915_CSI_VALID_PKT_SN) &&
+	    nla_put_u16(skb, MTK_VENDOR_ATTR_CSI_DATA_PKT_SN, csi->pkt_sn))
+		goto nla_put_failure;
+	if ((csi->metadata_valid & MT7915_CSI_VALID_SEGMENT) &&
+	    nla_put_u32(skb, MTK_VENDOR_ATTR_CSI_DATA_SEGMENT_NUM,
+			csi->segment_num))
+		goto nla_put_failure;
+	if ((csi->metadata_valid & MT7915_CSI_VALID_REMAIN_LAST) &&
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_REMAIN_LAST,
+		       csi->remain_last))
+		goto nla_put_failure;
+	if ((csi->metadata_valid & MT7915_CSI_VALID_TR_STREAM) &&
+	    nla_put_u8(skb, MTK_VENDOR_ATTR_CSI_DATA_TR_STREAM,
+		       csi->tr_stream))
+		goto nla_put_failure;
+
+	if (mt7915_csi_put_mac(skb, csi->ta) ||
+	    mt7915_csi_put_vector(skb, MTK_VENDOR_ATTR_CSI_DATA_I,
+				  csi->data_i, csi->data_num) ||
+	    mt7915_csi_put_vector(skb, MTK_VENDOR_ATTR_CSI_DATA_Q,
+				  csi->data_q, csi->data_num))
+		goto nla_put_failure;
+
+	nla_nest_end(skb, record);
+	return 0;
+
+nla_put_failure:
+	nla_nest_cancel(skb, record);
+	return -EMSGSIZE;
+}
+
+static int
+mt7915_vendor_csi_ctrl_dump(struct wiphy *wiphy, struct wireless_dev *wdev,
+			    struct sk_buff *skb, const void *data, int data_len,
+			    unsigned long *storage)
+{
+#define CSI_DUMP_LIMIT_SET	BIT(31)
+#define CSI_DUMP_LIMIT_MASK	GENMASK(15, 0)
+	struct ieee80211_hw *hw = wiphy_to_ieee80211_hw(wiphy);
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+	struct nlattr *tb[NUM_MTK_VENDOR_ATTRS_CSI_CTRL] = {};
+	struct csi_data *csi;
+	bool mask, reorder, requeued = false;
+	u16 limit;
+	int err, queued;
+
+	if (!(*storage & CSI_DUMP_LIMIT_SET)) {
+		if (data) {
+			err = nla_parse(tb, MTK_VENDOR_ATTR_CSI_CTRL_MAX,
+					data, data_len, csi_ctrl_policy, NULL);
+			if (err)
+				return err;
+		}
+
+		limit = tb[MTK_VENDOR_ATTR_CSI_CTRL_DUMP_NUM] ?
+			nla_get_u16(tb[MTK_VENDOR_ATTR_CSI_CTRL_DUMP_NUM]) :
+			U16_MAX;
+		*storage = CSI_DUMP_LIMIT_SET | limit;
+	}
+
+	limit = *storage & CSI_DUMP_LIMIT_MASK;
+	if (!limit)
+		return -ENOENT;
+
+	spin_lock_bh(&phy->csi.csi_lock);
+	if (list_empty(&phy->csi.csi_list)) {
+		spin_unlock_bh(&phy->csi.csi_lock);
+		return 0;
+	}
+
+	csi = list_first_entry(&phy->csi.csi_list, struct csi_data, node);
+	list_del_init(&csi->node);
+	phy->csi.count--;
+	mask = phy->csi.mask;
+	reorder = phy->csi.reorder;
+	spin_unlock_bh(&phy->csi.csi_lock);
+
+	mt7915_vendor_csi_tone_mask(csi, mask, reorder);
+	err = mt7915_csi_put_record(skb, csi);
+	if (err) {
+		spin_lock_bh(&phy->csi.csi_lock);
+		if (phy->csi.enable && phy->csi.count < CSI_MAX_BUF_NUM) {
+			list_add(&csi->node, &phy->csi.csi_list);
+			phy->csi.count++;
+			requeued = true;
+		} else {
+			phy->csi.dropped++;
+		}
+		spin_unlock_bh(&phy->csi.csi_lock);
+
+		if (!requeued)
+			kfree(csi);
+		return err;
+	}
+
+	kfree(csi);
+	limit--;
+	*storage = CSI_DUMP_LIMIT_SET | limit;
+
+	spin_lock_bh(&phy->csi.csi_lock);
+	queued = phy->csi.count;
+	spin_unlock_bh(&phy->csi.csi_lock);
+
+	return limit ? queued : 0;
+}
+
+static const struct wiphy_vendor_command mt7915_vendor_commands[] = {
+	{
+		.info = {
+			.vendor_id = MTK_NL80211_VENDOR_ID,
+			.subcmd = MTK_NL80211_VENDOR_SUBCMD_CSI_CTRL,
+		},
+		.flags = WIPHY_VENDOR_CMD_NEED_NETDEV |
+			 WIPHY_VENDOR_CMD_NEED_RUNNING,
+		.doit = mt7915_vendor_csi_ctrl,
+		.dumpit = mt7915_vendor_csi_ctrl_dump,
+		.policy = csi_ctrl_policy,
+		.maxattr = MTK_VENDOR_ATTR_CSI_CTRL_MAX,
+	}
+};
+
+void mt7915_vendor_register(struct mt7915_phy *phy)
+{
+	phy->mt76->hw->wiphy->vendor_commands = mt7915_vendor_commands;
+	phy->mt76->hw->wiphy->n_vendor_commands = ARRAY_SIZE(mt7915_vendor_commands);
+}
